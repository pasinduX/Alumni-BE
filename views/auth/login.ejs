<%- /* views/auth/login.ejs — Alumni Web Login (Gold palette) */ %>
<style>
  .main { max-width: none !important; padding: 0 !important; }
</style>

<div style="min-height:calc(100vh - var(--nav-h));display:flex;align-items:center;justify-content:center;padding:2rem;background:#0F0A05;background-image:radial-gradient(ellipse 90% 55% at 50% 100%, rgba(201,168,76,0.22) 0%, transparent 65%), radial-gradient(ellipse 50% 30% at 20% 20%, rgba(201,168,76,0.06) 0%, transparent 60%);">
  <div style="width:100%;max-width:420px;">

    <!-- Brand header -->
    <div style="text-align:center;margin-bottom:2rem;">
      <div style="width:60px;height:60px;background:linear-gradient(135deg,#C9A84C 0%,#A8871C 100%);border-radius:15px;display:flex;align-items:center;justify-content:center;margin:0 auto 1.25rem;box-shadow:0 6px 24px rgba(201,168,76,0.4);">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
        </svg>
      </div>
      <h1 style="font-family:'Playfair Display',Georgia,serif;font-size:1.8rem;font-weight:600;color:#FDFAF4;letter-spacing:-0.4px;margin-bottom:6px;">Welcome back</h1>
      <p style="font-size:13.5px;color:rgba(253,250,244,0.5);">Sign in to your alumni account</p>
    </div>

    <!-- Card -->
    <div style="background:#FDFAF4;border-radius:18px;padding:2rem 2.25rem;box-shadow:0 24px 64px rgba(0,0,0,0.5),0 0 0 1px rgba(201,168,76,0.18);border-top:4px solid #C9A84C;">

      <% if (messages && messages.success) { %>
        <div style="padding:11px 14px;background:#E8F7EE;border:1px solid #6EE7B7;border-left:3px solid #059669;border-radius:8px;font-size:13px;color:#065F46;display:flex;align-items:center;gap:8px;margin-bottom:1rem;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          <%= messages.success %>
        </div>
      <% } %>
      <% if (messages && messages.error) { %>
        <div style="padding:11px 14px;background:#FEF0F0;border:1px solid #FCA5A5;border-left:3px solid #BE3333;border-radius:8px;font-size:13px;color:#BE3333;display:flex;align-items:center;gap:8px;margin-bottom:1rem;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <%= messages.error %>
        </div>
      <% } %>
      <div id="loginAlert" style="display:none;padding:11px 14px;background:#FEF0F0;border:1px solid #FCA5A5;border-left:3px solid #BE3333;border-radius:8px;font-size:13px;color:#BE3333;align-items:center;gap:8px;margin-bottom:1rem;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span id="loginAlertMsg"></span>
      </div>

      <form id="loginForm" method="POST" action="/auth/login" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div style="margin-bottom:1rem;">
          <label style="display:block;font-size:12.5px;font-weight:600;color:#4B443C;margin-bottom:5px;letter-spacing:0.1px;">Email address</label>
          <input id="email" name="email" type="email" placeholder="you@eastminster.ac.uk" autocomplete="email" required
            style="width:100%;padding:10px 13px;font-family:'Inter',system-ui,sans-serif;font-size:13.5px;color:#18130E;background:#fff;border:1.5px solid rgba(0,0,0,0.14);border-radius:9px;outline:none;transition:border-color 0.15s,box-shadow 0.15s;box-sizing:border-box;"
            onfocus="this.style.borderColor='#C9A84C';this.style.boxShadow='0 0 0 3px rgba(201,168,76,0.14)'"
            onblur="this.style.borderColor='rgba(0,0,0,0.14)';this.style.boxShadow='none'" />
          <div class="field-error" id="err-email"></div>
        </div>

        <div style="margin-bottom:1.25rem;">
          <label style="display:flex;justify-content:space-between;align-items:center;font-size:12.5px;font-weight:600;color:#4B443C;margin-bottom:5px;">
            Password
            <a href="/web/forgot-password" style="font-size:12px;color:#A8871C;text-decoration:none;font-weight:500;">Forgot password?</a>
          </label>
          <div style="position:relative;">
            <input id="password" name="password" type="password" placeholder="••••••••" autocomplete="current-password" required
              style="width:100%;padding:10px 42px 10px 13px;font-family:'Inter',system-ui,sans-serif;font-size:13.5px;color:#18130E;background:#fff;border:1.5px solid rgba(0,0,0,0.14);border-radius:9px;outline:none;transition:border-color 0.15s,box-shadow 0.15s;box-sizing:border-box;"
              onfocus="this.style.borderColor='#C9A84C';this.style.boxShadow='0 0 0 3px rgba(201,168,76,0.14)'"
              onblur="this.style.borderColor='rgba(0,0,0,0.14)';this.style.boxShadow='none'" />
            <button type="button" id="togglePwd" tabindex="-1"
              style="position:absolute;right:11px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:#8B8278;padding:0;display:flex;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <div class="field-error" id="err-password"></div>
        </div>

        <button type="submit" id="loginBtn"
          style="width:100%;padding:11px;font-family:'Inter',system-ui,sans-serif;font-size:14px;font-weight:600;color:#fff;background:linear-gradient(135deg,#C9A84C 0%,#A8871C 100%);border:none;border-radius:9px;cursor:pointer;box-shadow:0 3px 12px rgba(201,168,76,0.35);transition:all 0.18s;display:flex;align-items:center;justify-content:center;gap:7px;"
          onmouseover="this.style.boxShadow='0 5px 18px rgba(201,168,76,0.5)';this.style.transform='translateY(-1px)'"
          onmouseout="this.style.boxShadow='0 3px 12px rgba(201,168,76,0.35)';this.style.transform='translateY(0)'">
          <span class="btn-spinner" id="loginSpinner"></span>
          <span class="btn-label">Sign in</span>
        </button>
      </form>
    </div>

    <!-- Footer -->
    <p style="text-align:center;font-size:13px;color:rgba(253,250,244,0.45);margin-top:1.5rem;">
      Don't have an account? <a href="/web/register" style="color:#C9A84C;text-decoration:none;font-weight:600;">Join the network</a>
    </p>

  </div>
</div>

<script>
(function() {
  document.getElementById('togglePwd').addEventListener('click', function() {
    var inp = document.getElementById('password');
    inp.type = inp.type === 'password' ? 'text' : 'password';
  });

  function showError(id, msg) {
    var el = document.getElementById(id);
    if (el) { el.textContent = msg; el.className = 'field-error visible'; }
    var inp = document.getElementById(id.replace('err-',''));
    if (inp) inp.style.borderColor = '#BE3333';
  }
  function clearErrors() {
    document.querySelectorAll('.field-error').forEach(function(e) { e.textContent=''; e.className='field-error'; });
    document.getElementById('loginAlert').style.display = 'none';
  }
  function showAlert(msg) {
    var box = document.getElementById('loginAlert');
    document.getElementById('loginAlertMsg').textContent = msg;
    box.style.display = 'flex';
    box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  document.getElementById('loginForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    clearErrors();
    var btn = document.getElementById('loginBtn');
    btn.disabled = true;
    btn.classList.add('loading');

    try {
      var res = await fetch('/auth/login', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('[name=_csrf]').value },
        body: JSON.stringify({
          email: document.getElementById('email').value.trim(),
          password: document.getElementById('password').value,
        }),
      });

      if (res.ok) {
        var data = await res.json();
        window.location.href = data.role === 'university_staff' ? '/university/dashboard' : '/web/profile';
        return;
      }

      var data = await res.json();
      if (data.errors) {
        Object.entries(data.errors).forEach(function([k, v]) { showError('err-' + k, v); });
      } else {
        showAlert(data.error || 'Invalid credentials. Please try again.');
      }
    } catch (err) {
      showAlert('Network error — please try again.');
    }

    btn.disabled = false;
    btn.classList.remove('loading');
  });
})();
</script>
