<%- /* forgot-password.ejs */ %>

<div class="auth-bg">
  <div class="auth-panel">

    <div class="auth-header">
      <div class="auth-header-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <h1>Forgot password?</h1>
      <p>Enter your email and we'll send you a reset link</p>
    </div>

    <div class="auth-card">
      <div id="fpAlert" class="alert alert-danger" style="display:none;">
        <svg class="alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span id="fpAlertMsg"></span>
      </div>
      <div id="fpSuccess" class="alert alert-success" style="display:none;">
        <svg class="alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span>If that email is registered, a reset link has been sent. Check your inbox.</span>
      </div>

      <form id="fpForm" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="form-group">
          <label class="form-label" for="email">Email address <span class="required">*</span></label>
          <input class="form-control" type="email" id="email" name="email" placeholder="you@eastminster.ac.uk" autocomplete="email" required />
          <div class="field-error" id="err-email"></div>
        </div>

        <button type="submit" class="btn btn-gold btn-full" id="fpBtn" style="margin-top:0.5rem">
          <span class="btn-spinner"></span>
          <span class="btn-label">Send reset link</span>
        </button>
      </form>
    </div>

    <p class="auth-footer"><a href="/web/login">&larr; Back to sign in</a></p>
  </div>
</div>

<script>
(function() {
  function showAlert(msg) {
    const box = document.getElementById('fpAlert');
    document.getElementById('fpAlertMsg').textContent = msg;
    box.style.display = 'flex';
  }

  document.getElementById('fpForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const btn = document.getElementById('fpBtn');
    btn.disabled = true;
    btn.classList.add('loading');
    document.getElementById('fpAlert').style.display = 'none';

    try {
      const res = await fetch('/auth/forgot-password', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('[name=_csrf]').value },
        body: JSON.stringify({ email: document.getElementById('email').value.trim() }),
      });

      // Always show success message for security (don't reveal if email exists)
      document.getElementById('fpForm').style.display = 'none';
      document.getElementById('fpSuccess').style.display = 'flex';
    } catch (err) {
      showAlert('Network error — please try again.');
      btn.disabled = false;
      btn.classList.remove('loading');
    }
  });
})();
</script>
