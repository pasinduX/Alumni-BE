<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <% const pageTitle = (typeof title !== 'undefined' && title) ? title : 'AR Alumni Influencer Platform'; %>
  <title><%= pageTitle %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-light bg-light">
  <div class="container-fluid">
    <a class="navbar-brand" href="/web/profile">AR Alumni</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item"><a class="nav-link" href="/web/profile">Profile</a></li>
        <li class="nav-item"><a class="nav-link" href="/web/profile/degrees">Degrees</a></li>
        <li class="nav-item"><a class="nav-link" href="/web/profile/certifications">Certifications</a></li>
        <li class="nav-item"><a class="nav-link" href="/web/profile/licences">Licences</a></li>
        <li class="nav-item"><a class="nav-link" href="/web/profile/courses">Courses</a></li>
        <li class="nav-item"><a class="nav-link" href="/web/profile/employment">Employment</a></li>
      </ul>
      <ul class="navbar-nav">
        <% if (user) { %>
          <li class="nav-item"><span class="nav-link">Logged in: <%= user.userId %></span></li>
          <li class="nav-item"><a class="nav-link" href="/web/logout">Logout</a></li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/web/login">Login</a></li>
          <li class="nav-item"><a class="nav-link" href="/web/register">Register</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<div class="container mt-4">
  <% if (messages && messages.error) { %>
    <% messages.error.forEach((msg) => { %>
      <div class="alert alert-danger"><%= msg %></div>
    <% }) %>
  <% } %>
  <% if (messages && messages.success) { %>
    <% messages.success.forEach((msg) => { %>
      <div class="alert alert-success"><%= msg %></div>
    <% }) %>
  <% } %>
  <%- body %>
</div>

</body>
</html>