<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <% const pageTitle = (typeof title !== 'undefined' && title) ? title + ' — AR Alumni' : 'AR Alumni Influencer Platform'; %>
  <title><%= pageTitle %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;1,500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      /* Gold palette */
      --gold:           #C9A84C;
      --gold-dark:      #A8871C;
      --gold-light:     #F9F1DC;
      --gold-mid:       #DFB96A;
      --gold-shine:     #F0CC72;
      /* Neutrals */
      --ink:            #18130E;
      --ink-mid:        #4B443C;
      --ink-light:      #8B8278;
      --cream:          #FDFAF4;
      --cream-mid:      #F5F0E6;
      --white:          #FFFFFF;
      /* Borders */
      --border:         rgba(201,168,76,0.18);
      --border-mid:     rgba(201,168,76,0.32);
      --border-strong:  rgba(201,168,76,0.55);
      /* Semantic */
      --danger:         #BE3333;
      --danger-light:   #FEF0F0;
      --success:        #1A6B42;
      --success-light:  #E8F7EE;
      --info:           #1A5C8B;
      --info-light:     #EAF3FB;
      /* Radii */
      --radius-sm:      4px;
      --radius:         8px;
      --radius-lg:      14px;
      --radius-xl:      20px;
      /* Layout */
      --sidebar-w:      252px;
      --nav-h:          62px;
      /* Typography */
      --font-display:   'Playfair Display', Georgia, serif;
      --font-body:      'Inter', system-ui, sans-serif;
      /* Shadows */
      --shadow-sm:      0 1px 3px rgba(0,0,0,0.07), 0 1px 2px rgba(0,0,0,0.04);
      --shadow:         0 4px 12px rgba(0,0,0,0.08), 0 2px 4px rgba(0,0,0,0.04);
      --shadow-gold:    0 4px 20px rgba(201,168,76,0.18);
    }

    body {
      font-family: var(--font-body);
      background: var(--cream);
      color: var(--ink);
      font-size: 14.5px;
      line-height: 1.65;
      min-height: 100vh;
    }

    /* ── Top Nav ── */
    .topnav {
      position: sticky;
      top: 0;
      z-index: 200;
      background: var(--ink);
      border-bottom: 2px solid var(--gold-dark);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 2rem;
      height: var(--nav-h);
      box-shadow: 0 2px 16px rgba(0,0,0,0.35);
    }

    .topnav-brand {
      display: flex;
      align-items: center;
      gap: 11px;
      text-decoration: none;
      flex-shrink: 0;
    }
    .topnav-brand-mark {
      width: 34px;
      height: 34px;
      background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-display);
      font-size: 13px;
      font-weight: 600;
      color: var(--white);
      letter-spacing: 0.3px;
      box-shadow: 0 2px 8px rgba(201,168,76,0.4);
    }
    .topnav-brand-text {
      font-family: var(--font-display);
      font-size: 16px;
      font-weight: 600;
      color: var(--white);
      letter-spacing: 0.2px;
      line-height: 1;
    }
    .topnav-brand-sub {
      font-size: 10.5px;
      color: var(--gold-mid);
      letter-spacing: 1.2px;
      text-transform: uppercase;
      font-family: var(--font-body);
      font-weight: 500;
      margin-top: 2px;
    }

    .topnav-right {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .topnav-user-pill {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 5px 12px 5px 6px;
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 100px;
      font-size: 12.5px;
      color: rgba(255,255,255,0.7);
    }
    .topnav-user-avatar {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      font-weight: 600;
      color: white;
      flex-shrink: 0;
    }
    .btn-nav {
      font-family: var(--font-body);
      font-size: 12.5px;
      font-weight: 500;
      padding: 7px 16px;
      border-radius: 100px;
      border: 1px solid rgba(255,255,255,0.18);
      color: rgba(255,255,255,0.72);
      background: transparent;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.18s;
      letter-spacing: 0.1px;
    }
    .btn-nav:hover {
      background: rgba(255,255,255,0.1);
      color: var(--white);
      border-color: rgba(255,255,255,0.3);
    }
    .btn-nav.primary {
      background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
      border-color: transparent;
      color: var(--white);
      box-shadow: 0 2px 8px rgba(201,168,76,0.35);
    }
    .btn-nav.primary:hover {
      background: linear-gradient(135deg, var(--gold-shine) 0%, var(--gold) 100%);
      box-shadow: 0 3px 12px rgba(201,168,76,0.5);
    }

    /* ── Shell ── */
    .shell {
      display: flex;
      min-height: calc(100vh - var(--nav-h));
    }

    /* ── Sidebar ── */
    .sidebar {
      width: var(--sidebar-w);
      flex-shrink: 0;
      background: var(--white);
      border-right: 1px solid var(--border);
      padding: 1.75rem 0;
      position: sticky;
      top: var(--nav-h);
      height: calc(100vh - var(--nav-h));
      overflow-y: auto;
    }

    .sidebar-section {
      padding: 0 1rem;
      margin-bottom: 1.75rem;
    }
    .sidebar-label {
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 1.4px;
      text-transform: uppercase;
      color: var(--ink-light);
      margin-bottom: 6px;
      padding: 0 8px;
    }

    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 8px 10px;
      border-radius: var(--radius-sm);
      font-size: 13.5px;
      color: var(--ink-mid);
      text-decoration: none;
      font-weight: 400;
      transition: all 0.14s;
      margin-bottom: 2px;
    }
    .sidebar-link:hover {
      background: var(--cream-mid);
      color: var(--ink);
    }
    .sidebar-link.active {
      background: var(--gold-light);
      color: var(--gold-dark);
      font-weight: 600;
    }
    .sidebar-link svg { width: 15px; height: 15px; flex-shrink: 0; opacity: 0.65; }
    .sidebar-link.active svg { opacity: 1; color: var(--gold); }
    .sidebar-link:hover svg { opacity: 0.9; }

    .sidebar-divider {
      height: 1px;
      background: var(--border);
      margin: 0.5rem 1rem;
    }

    /* ── Main ── */
    .main {
      flex: 1;
      min-width: 0;
      padding: 2.5rem 3rem;
      max-width: 900px;
    }

    /* ── Page Header ── */
    .page-header {
      margin-bottom: 2rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .page-header-text h1 {
      font-family: var(--font-display);
      font-size: 26px;
      font-weight: 600;
      color: var(--ink);
      letter-spacing: -0.3px;
      line-height: 1.2;
    }
    .page-header-text p {
      font-size: 13.5px;
      color: var(--ink-light);
      margin-top: 5px;
    }
    /* Legacy compatibility: direct h1 under .page-header */
    .page-header > h1 {
      font-family: var(--font-display);
      font-size: 26px;
      font-weight: 600;
      color: var(--ink);
      letter-spacing: -0.3px;
    }
    .page-header > p {
      font-size: 13.5px;
      color: var(--ink-light);
      margin-top: 5px;
    }

    /* ── Alerts / Toasts ── */
    .alert {
      padding: 13px 16px 13px 14px;
      border-radius: var(--radius);
      font-size: 13.5px;
      margin-bottom: 1rem;
      border-left: 3px solid;
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }
    .alert-icon { flex-shrink: 0; width: 16px; height: 16px; margin-top: 1px; }
    .alert-danger  { background: var(--danger-light);  color: var(--danger);  border-color: var(--danger); }
    .alert-success { background: var(--success-light); color: var(--success); border-color: var(--success); }
    .alert-info    { background: var(--info-light);    color: var(--info);    border-color: var(--info); }

    /* Inline error text under form fields */
    .field-error { font-size: 12px; color: var(--danger); margin-top: 4px; display: none; }
    .field-error.visible { display: block; }

    /* ── Cards ── */
    .card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.75rem;
      margin-bottom: 1.5rem;
      box-shadow: var(--shadow-sm);
    }
    .card-title {
      font-family: var(--font-display);
      font-size: 16.5px;
      font-weight: 600;
      color: var(--ink);
      margin-bottom: 1.25rem;
      padding-bottom: 0.85rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .card-title svg { width: 18px; height: 18px; color: var(--gold); }

    /* ── Badge ── */
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 2px 8px;
      border-radius: 100px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.3px;
    }
    .badge-gold { background: var(--gold-light); color: var(--gold-dark); border: 1px solid var(--border-mid); }
    .badge-green { background: var(--success-light); color: var(--success); }

    /* ── Form Elements ── */
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.25rem; }
    .form-group { margin-bottom: 1.1rem; }
    .form-label {
      display: block;
      font-size: 12.5px;
      font-weight: 600;
      color: var(--ink-mid);
      margin-bottom: 5px;
      letter-spacing: 0.1px;
    }
    .form-label .required { color: var(--danger); margin-left: 2px; }
    .form-control {
      width: 100%;
      padding: 9px 13px;
      font-family: var(--font-body);
      font-size: 13.5px;
      color: var(--ink);
      background: var(--white);
      border: 1.5px solid rgba(0,0,0,0.14);
      border-radius: var(--radius);
      outline: none;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .form-control:focus {
      border-color: var(--gold);
      box-shadow: 0 0 0 3px rgba(201,168,76,0.14);
    }
    .form-control.error { border-color: var(--danger); }
    .form-control.error:focus { box-shadow: 0 0 0 3px rgba(190,51,51,0.12); }
    .form-control::placeholder { color: var(--ink-light); }
    textarea.form-control { resize: vertical; min-height: 90px; }
    .form-hint { font-size: 11.5px; color: var(--ink-light); margin-top: 5px; }
    select.form-control { cursor: pointer; }

    /* ── Buttons ── */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      padding: 9px 22px;
      font-family: var(--font-body);
      font-size: 13.5px;
      font-weight: 600;
      border-radius: var(--radius);
      border: 1.5px solid transparent;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.17s;
      letter-spacing: 0.1px;
      white-space: nowrap;
    }
    .btn:disabled { opacity: 0.55; cursor: not-allowed; }
    .btn svg { width: 15px; height: 15px; flex-shrink: 0; }

    .btn-primary {
      background: var(--ink);
      color: var(--white);
      border-color: var(--ink);
    }
    .btn-primary:hover:not(:disabled) { background: #2A231D; }

    .btn-gold {
      background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
      color: var(--white);
      border-color: transparent;
      box-shadow: 0 2px 8px rgba(201,168,76,0.3);
    }
    .btn-gold:hover:not(:disabled) {
      background: linear-gradient(135deg, var(--gold-shine) 0%, var(--gold) 100%);
      box-shadow: 0 4px 14px rgba(201,168,76,0.45);
      transform: translateY(-1px);
    }

    .btn-outline {
      background: transparent;
      color: var(--gold-dark);
      border-color: var(--border-strong);
    }
    .btn-outline:hover:not(:disabled) { background: var(--gold-light); }

    .btn-ghost {
      background: transparent;
      color: var(--ink-mid);
      border-color: rgba(0,0,0,0.14);
    }
    .btn-ghost:hover:not(:disabled) { background: var(--cream-mid); color: var(--ink); }

    .btn-danger {
      background: transparent;
      color: var(--danger);
      border-color: rgba(190,51,51,0.25);
      font-size: 12px;
      padding: 5px 12px;
      font-weight: 500;
    }
    .btn-danger:hover:not(:disabled) { background: var(--danger-light); border-color: var(--danger); }

    .btn-sm { padding: 5px 14px; font-size: 12px; border-radius: var(--radius-sm); }
    .btn-full { width: 100%; }
    .btn-spinner {
      width: 14px; height: 14px;
      border: 2px solid rgba(255,255,255,0.4);
      border-top-color: white;
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
      display: none;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .btn.loading .btn-spinner { display: inline-block; }
    .btn.loading .btn-label { opacity: 0.7; }

    /* ── Table ── */
    .data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13.5px;
    }
    .data-table th {
      text-align: left;
      padding: 10px 14px;
      font-size: 10.5px;
      font-weight: 600;
      letter-spacing: 0.9px;
      text-transform: uppercase;
      color: var(--ink-light);
      background: var(--cream);
      border-bottom: 1px solid var(--border);
    }
    .data-table th:first-child { border-radius: var(--radius-sm) 0 0 0; }
    .data-table th:last-child  { border-radius: 0 var(--radius-sm) 0 0; }
    .data-table td {
      padding: 11px 14px;
      border-bottom: 1px solid var(--border);
      color: var(--ink-mid);
      vertical-align: middle;
    }
    .data-table td:first-child { color: var(--ink); font-weight: 500; }
    .data-table tr:last-child td { border-bottom: none; }
    .data-table tr:hover td { background: var(--cream); transition: background 0.1s; }

    .table-link { color: var(--gold-dark); text-decoration: none; font-size: 12.5px; font-weight: 500; }
    .table-link:hover { text-decoration: underline; }

    .empty-state {
      text-align: center;
      padding: 3rem 2rem;
      color: var(--ink-light);
      font-size: 13.5px;
    }
    .empty-state-icon {
      width: 44px; height: 44px;
      background: var(--cream-mid);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 1rem;
      color: var(--gold);
    }
    .empty-state-icon svg { width: 22px; height: 22px; }
    .empty-state p { max-width: 240px; margin: 0 auto; line-height: 1.5; }

    /* ── Divider ── */
    .section-divider {
      height: 1px; background: var(--border); margin: 1.75rem 0;
    }

    /* ── Auth pages ── */
    .auth-bg {
      min-height: calc(100vh - var(--nav-h));
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      background: var(--cream);
      background-image:
        radial-gradient(ellipse 80% 50% at 50% -10%, rgba(201,168,76,0.09) 0%, transparent 70%);
    }
    .auth-panel {
      width: 100%;
      max-width: 430px;
    }
    .auth-header { text-align: center; margin-bottom: 2rem; }
    .auth-header-icon {
      width: 52px; height: 52px;
      background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
      border-radius: var(--radius-lg);
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 1rem;
      box-shadow: var(--shadow-gold);
    }
    .auth-header-icon svg { width: 26px; height: 26px; color: white; }
    .auth-header h1 {
      font-family: var(--font-display);
      font-size: 26px;
      font-weight: 600;
      color: var(--ink);
      margin-bottom: 6px;
    }
    .auth-header p {
      font-size: 13.5px;
      color: var(--ink-light);
    }
    .auth-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      padding: 2rem 2.25rem;
      box-shadow: var(--shadow);
    }
    .auth-footer { margin-top: 1.25rem; text-align: center; font-size: 13px; color: var(--ink-light); }
    .auth-footer a { color: var(--gold-dark); text-decoration: none; font-weight: 600; }
    .auth-footer a:hover { text-decoration: underline; }
    /* legacy */
    .auth-wrapper { min-height: calc(100vh - var(--nav-h)); display:flex; align-items:center; justify-content:center; padding:2rem; }
    .auth-link { font-size:13px; color:var(--ink-light); margin-top:1.25rem; text-align:center; }
    .auth-link a { color:var(--gold-dark); text-decoration:none; font-weight:600; }
    .auth-link a:hover { text-decoration:underline; }

    /* ── Profile ── */
    .profile-hero {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      margin-bottom: 1.75rem;
    }
    .profile-avatar-wrap { position: relative; flex-shrink: 0; }
    .profile-avatar {
      width: 76px;
      height: 76px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid var(--gold-light);
      box-shadow: 0 0 0 1px var(--border-mid);
    }
    .profile-avatar-placeholder {
      width: 76px;
      height: 76px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--gold-light) 0%, var(--cream-mid) 100%);
      border: 3px solid var(--gold-light);
      box-shadow: 0 0 0 1px var(--border-mid);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-display);
      font-size: 26px;
      color: var(--gold-dark);
      font-weight: 600;
    }
    .profile-info h2 {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 600;
      color: var(--ink);
      margin-bottom: 4px;
    }
    .profile-info .profile-email {
      font-size: 12.5px;
      color: var(--ink-light);
    }
    .profile-info .profile-bio {
      font-size: 13.5px;
      color: var(--ink-mid);
      margin-top: 4px;
      line-height: 1.45;
    }

    .upload-area {
      border: 1.5px dashed var(--border-strong);
      border-radius: var(--radius);
      padding: 1.5rem 1rem;
      text-align: center;
      font-size: 13px;
      color: var(--ink-light);
      cursor: pointer;
      transition: all 0.15s;
      display: block;
    }
    .upload-area:hover { background: var(--gold-light); border-color: var(--gold); color: var(--gold-dark); }
    .upload-area-title { font-weight: 600; font-size: 13.5px; color: var(--ink-mid); margin: 8px 0 3px; }

    /* ── Quick Links grid ── */
    .quick-links {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }
    .quick-link {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 7px;
      padding: 16px 10px;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      background: var(--cream);
      font-size: 12px;
      font-weight: 600;
      color: var(--ink-mid);
      text-decoration: none;
      transition: all 0.17s;
      text-align: center;
      letter-spacing: 0.1px;
    }
    .quick-link:hover {
      background: var(--gold-light);
      border-color: var(--border-strong);
      color: var(--gold-dark);
      transform: translateY(-2px);
      box-shadow: var(--shadow-sm);
    }
    .quick-link svg { width: 20px; height: 20px; }
    .quick-link-count {
      font-size: 16px;
      font-family: var(--font-display);
      font-weight: 600;
      color: var(--gold-dark);
      line-height: 1;
    }

    /* ── Checkbox ── */
    .form-check {
      display: flex; align-items: center; gap: 8px;
      font-size: 13.5px; color: var(--ink-mid);
    }
    .form-check-input {
      width: 16px; height: 16px;
      accent-color: var(--gold);
      cursor: pointer;
    }

    /* ── Responsive ── */
    @media (max-width: 800px) {
      .sidebar { display: none; }
      .main { padding: 1.5rem; }
      .quick-links { grid-template-columns: repeat(2, 1fr); }
      .form-row { grid-template-columns: 1fr; }
    }

    /* ── Hamburger button (shown on mobile only) ── */
    .btn-hamburger {
      display: none;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: var(--radius-sm);
      cursor: pointer;
      color: var(--white);
      flex-shrink: 0;
      transition: background 0.15s;
    }
    .btn-hamburger:hover { background: rgba(255,255,255,0.15); }
    .btn-hamburger svg { width: 18px; height: 18px; pointer-events: none; }

    /* ── Mobile sidebar drawer ── */
    .sidebar-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.45);
      z-index: 190;
      backdrop-filter: blur(2px);
    }
    .sidebar-backdrop.open { display: block; }

    @media (max-width: 800px) {
      .btn-hamburger { display: flex; }

      .sidebar {
        display: block;          /* override the hide-on-mobile rule */
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        z-index: 195;
        transform: translateX(-110%);
        transition: transform 0.25s cubic-bezier(0.4,0,0.2,1);
        box-shadow: 4px 0 24px rgba(0,0,0,0.18);
        padding-top: calc(var(--nav-h) + 0.5rem); /* clear the fixed topnav */
      }
      .sidebar.open {
        transform: translateX(0);
      }
    }
  </style>
</head>
<body>

<nav class="topnav">
  <div style="display:flex;align-items:center;gap:10px;">
    <% if (typeof user !== 'undefined' && user) { %>
    <button class="btn-hamburger" id="sidebarToggle" aria-label="Toggle navigation" aria-expanded="false">
      <svg id="hamburgerIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      <svg id="closeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <% } %>
    <a class="topnav-brand" href="<%= (typeof user !== 'undefined' && user) ? '/web/profile' : '/web/login' %>">
      <div class="topnav-brand-mark">AR</div>
      <div>
        <div class="topnav-brand-text">Alumni Network</div>
        <div class="topnav-brand-sub">Influencer Platform</div>
      </div>
    </a>
  </div><!-- /.topnav-left -->
  <div class="topnav-right">
    <% if (typeof user !== 'undefined' && user) { %>
      <div class="topnav-user-pill">
        <div class="topnav-user-avatar"><%= (user.email || user.userId || '?').toString()[0].toUpperCase() %></div>
        <span><%= user.email || ('User #' + user.userId) %></span>
      </div>
      <form method="post" action="/web/logout" style="display:inline">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
        <button type="submit" class="btn-nav">Sign out</button>
      </form>
    <% } else { %>
      <a class="btn-nav" href="/web/login">Sign in</a>
      <a class="btn-nav primary" href="/web/register">Join</a>
    <% } %>
  </div>
</nav>

<div class="shell">
  <% if (typeof user !== 'undefined' && user) { %>
  <aside class="sidebar">
    <div class="sidebar-section">
      <div class="sidebar-label">My Profile</div>
      <a class="sidebar-link <%= (currentPath === '/web/profile') ? 'active' : '' %>" href="/web/profile">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
        Overview
      </a>
      <a class="sidebar-link <%= (currentPath === '/web/profile/employment') ? 'active' : '' %>" href="/web/profile/employment">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M8 7V5a4 4 0 0 1 8 0v2"/></svg>
        Employment
      </a>
    </div>
    <div class="sidebar-divider"></div>
    <div class="sidebar-section">
      <div class="sidebar-label">Credentials</div>
      <a class="sidebar-link <%= (currentPath === '/web/profile/degrees') ? 'active' : '' %>" href="/web/profile/degrees">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
        Degrees
      </a>
      <a class="sidebar-link <%= (currentPath === '/web/profile/certifications') ? 'active' : '' %>" href="/web/profile/certifications">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="6"/><path d="m9 12 2 2 4-4"/><path d="M9.7 17 9 22l3-2 3 2-.7-5"/></svg>
        Certifications
      </a>
      <a class="sidebar-link <%= (currentPath === '/web/profile/licences') ? 'active' : '' %>" href="/web/profile/licences">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h10M7 12h6"/></svg>
        Licences
      </a>
      <a class="sidebar-link <%= (currentPath === '/web/profile/courses') ? 'active' : '' %>" href="/web/profile/courses">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        Courses
      </a>
    </div>
  </aside>
  <% } %>

  <main class="main">
    <% if (typeof messages !== 'undefined' && messages && messages.error) { %>
      <% const errors = Array.isArray(messages.error) ? messages.error : [messages.error]; %>
      <% errors.forEach(function(msg) { %>
        <div class="alert alert-danger">
          <svg class="alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <%= msg %>
        </div>
      <% }) %>
    <% } %>
    <% if (typeof messages !== 'undefined' && messages && messages.success) { %>
      <% const successes = Array.isArray(messages.success) ? messages.success : [messages.success]; %>
      <% successes.forEach(function(msg) { %>
        <div class="alert alert-success">
          <svg class="alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <%= msg %>
        </div>
      <% }) %>
    <% } %>
    <%- body %>
  </main>
</div>

<!-- Mobile sidebar backdrop -->
<div class="sidebar-backdrop" id="sidebarBackdrop"></div>

<script>
  (function () {
    var toggle    = document.getElementById('sidebarToggle');
    var backdrop  = document.getElementById('sidebarBackdrop');
    var sidebar   = document.querySelector('.sidebar');
    var hamIcon   = document.getElementById('hamburgerIcon');
    var closeIcon = document.getElementById('closeIcon');
    if (!toggle || !sidebar) return;

    function openSidebar() {
      sidebar.classList.add('open');
      backdrop.classList.add('open');
      toggle.setAttribute('aria-expanded', 'true');
      hamIcon.style.display   = 'none';
      closeIcon.style.display = '';
      document.body.style.overflow = 'hidden';
    }

    function closeSidebar() {
      sidebar.classList.remove('open');
      backdrop.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
      hamIcon.style.display   = '';
      closeIcon.style.display = 'none';
      document.body.style.overflow = '';
    }

    toggle.addEventListener('click', function () {
      sidebar.classList.contains('open') ? closeSidebar() : openSidebar();
    });

    backdrop.addEventListener('click', closeSidebar);

    // Close on nav link click (navigating away)
    sidebar.querySelectorAll('a.sidebar-link').forEach(function (link) {
      link.addEventListener('click', closeSidebar);
    });

    // Close on Escape key
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeSidebar();
    });
  })();
</script>

</body>
</html>
