<%# views/university/charts/geographic.ejs %>

<style>
  .uni-main {
    flex: 1; padding: 2rem 2.5rem;
    display: flex; flex-direction: column; gap: 1.5rem;
    background: var(--up-surface);
    animation: uniPageIn 0.32s cubic-bezier(0.22,1,0.36,1) both;
  }
  .up-breadcrumb { display:flex; align-items:center; gap:6px; font-size:12px; color:var(--up-muted); flex-wrap:wrap; }
  .up-breadcrumb a { color:var(--up-blue); text-decoration:none; font-weight:500; }
  .up-breadcrumb a:hover { color:#1D4ED8; text-decoration:underline; }
  .up-breadcrumb-sep { color:var(--up-border); }
  .up-breadcrumb-current { color:var(--up-text-mid); font-weight:500; }

  .up-page-header-text h1 { font-size:1.45rem; font-weight:700; color:var(--up-text); letter-spacing:-0.3px; }
  .up-page-header-text p  { font-size:13px; color:var(--up-muted); margin-top:4px; }

  /* Stat row */
  .up-stat-row { display:grid; grid-template-columns:repeat(auto-fill,minmax(160px,1fr)); gap:1rem; }
  .up-stat {
    background:var(--up-white); border:1px solid var(--up-border);
    border-radius:var(--up-radius); padding:1rem 1.2rem; box-shadow:var(--up-shadow);
    transition:box-shadow 0.18s, transform 0.18s;
  }
  .up-stat:hover { box-shadow:0 4px 16px rgba(37,99,235,0.1); transform:translateY(-1px); }
  .up-stat-label { font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:0.7px; color:var(--up-muted); }
  .up-stat-value { font-size:1.45rem; font-weight:700; color:var(--up-text); line-height:1; margin-top:6px; letter-spacing:-0.3px; word-break:break-word; }
  .up-stat-value.accent { color:var(--up-blue); }

  /* Layout */
  .geo-grid { display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; }
  @media (max-width: 900px) { .geo-grid { grid-template-columns:1fr; } .uni-main { padding:1.25rem; } }

  .up-chart-card {
    background:var(--up-white); border:1px solid var(--up-border);
    border-radius:var(--up-radius); box-shadow:var(--up-shadow);
    display:flex; flex-direction:column; overflow:hidden;
  }
  .up-chart-card-head {
    display:flex; align-items:center; justify-content:space-between;
    padding:1.1rem 1.5rem; border-bottom:1px solid var(--up-border); gap:1rem; flex-wrap:wrap;
  }
  .up-chart-card-title { font-size:14px; font-weight:700; color:var(--up-text); }
  .up-chart-card-sub   { font-size:12px; color:var(--up-muted); margin-top:2px; }
  .up-btn-icon {
    display:inline-flex; align-items:center; gap:5px; padding:6px 12px;
    border-radius:8px; border:1px solid var(--up-border); background:var(--up-white);
    color:var(--up-text-mid); font-size:12px; font-weight:600; cursor:pointer; transition:all 0.15s;
  }
  .up-btn-icon:hover { border-color:var(--up-blue-400); background:var(--up-blue-light); color:var(--up-blue); }
  .up-btn-icon svg { width:13px; height:13px; }
  .up-chart-body { padding:1.25rem; flex:1; }
  .up-chart-wrap { position:relative; height:340px; }

  /* Country table */
  .geo-table { width:100%; border-collapse:collapse; font-size:13px; }
  .geo-table th {
    text-align:left; padding:0.6rem 1rem; font-size:10.5px; font-weight:700;
    letter-spacing:0.8px; text-transform:uppercase; color:var(--up-muted);
    background:var(--up-surface); border-bottom:1px solid var(--up-border);
  }
  .geo-table td { padding:0.7rem 1rem; border-bottom:1px solid var(--up-border); color:var(--up-text-mid); vertical-align:middle; }
  .geo-table tr:last-child td { border-bottom:none; }
  .geo-table tr:hover td { background:var(--up-blue-light); transition:background 0.12s; }
  .geo-rank { display:inline-flex; align-items:center; justify-content:center; width:22px; height:22px; border-radius:6px; font-size:11px; font-weight:700; }
  .geo-rank-1 { background:#FEF9C3; color:#854D0E; }
  .geo-rank-2 { background:#F1F5F9; color:#475569; }
  .geo-rank-3 { background:#FEF3C7; color:#92400E; }
  .geo-rank-n { background:var(--up-surface); color:var(--up-muted); }
  .geo-bar-wrap { width:100%; max-width:120px; background:var(--up-surface); border-radius:3px; overflow:hidden; }
  .geo-bar { height:6px; border-radius:3px; background:var(--up-blue); transition:width 0.6s cubic-bezier(0.4,0,0.2,1); min-width:4px; }

  .up-empty {
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    gap:10px; height:300px; color:var(--up-muted); font-size:13.5px; text-align:center;
  }
  .up-empty svg { width:40px; height:40px; opacity:0.3; }
</style>

<div class="uni-shell">

  <%- include('../partials/sidebar', { activePage: 'geographic' }) %>

  <main class="uni-main">

    <nav class="up-breadcrumb">
      <a href="/university/dashboard">Dashboard</a>
      <span class="up-breadcrumb-sep">›</span>
      <span>Analytics</span>
      <span class="up-breadcrumb-sep">›</span>
      <span class="up-breadcrumb-current">Geographic Distribution</span>
    </nav>

    <%- include('../partials/filter-bar', {
      filterAction: '/university/charts/geographic',
      programmes, graduationYears, selectedProgramme, selectedYear
    }) %>

    <div class="up-page-header-text">
      <h1>Geographic Distribution</h1>
      <p>Where in the world alumni are employed<% if (selectedProgramme) { %> — <strong><%= selectedProgramme %></strong><% } %><% if (selectedYear) { %>, class of <strong><%= selectedYear %></strong><% } %>.</p>
    </div>

    <!-- Stat strip -->
    <div class="up-stat-row">
      <div class="up-stat">
        <div class="up-stat-label">Countries</div>
        <div class="up-stat-value accent" id="statCountries">—</div>
      </div>
      <div class="up-stat">
        <div class="up-stat-label">Top Country</div>
        <div class="up-stat-value" id="statTopCountry">—</div>
      </div>
      <div class="up-stat">
        <div class="up-stat-label">Alumni in Top</div>
        <div class="up-stat-value" id="statTopCount">—</div>
      </div>
      <div class="up-stat">
        <div class="up-stat-label">Largest Share</div>
        <div class="up-stat-value accent" id="statTopPct">—</div>
      </div>
    </div>

    <div class="geo-grid">

      <!-- Doughnut chart -->
      <div class="up-chart-card">
        <div class="up-chart-card-head">
          <div>
            <div class="up-chart-card-title">Alumni by Country</div>
            <div class="up-chart-card-sub">Distribution of recorded locations</div>
          </div>
          <button class="up-btn-icon" id="btnDownload">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Export PNG
          </button>
        </div>
        <div class="up-chart-body">
          <div class="up-chart-wrap" id="chartWrap">
            <canvas id="geoChart"></canvas>
          </div>
        </div>
      </div>

      <!-- Country table -->
      <div class="up-chart-card">
        <div class="up-chart-card-head">
          <div>
            <div class="up-chart-card-title">Country Breakdown</div>
            <div class="up-chart-card-sub">Alumni count and share per country</div>
          </div>
        </div>
        <div style="overflow-x:auto; flex:1;">
          <table class="geo-table" id="geoTable">
            <thead>
              <tr>
                <th style="width:44px">#</th>
                <th>Country / Region</th>
                <th>Alumni</th>
                <th style="min-width:130px">Share</th>
              </tr>
            </thead>
            <tbody id="geoTableBody"></tbody>
          </table>
          <div id="geoTableEmpty" class="up-empty" style="display:none;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"/>
              <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
            No location data available. Add employment history with location to see this chart.
          </div>
        </div>
      </div>

    </div>

  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
(function () {
  var raw = <%- chartData %>;

  if (!raw || !raw.length) {
    document.getElementById('chartWrap').innerHTML =
      '<div class="up-empty">' +
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>' +
      '<p>No location data available.</p></div>';
    document.getElementById('geoTableEmpty').style.display = '';
    ['statCountries','statTopCountry','statTopCount','statTopPct'].forEach(function(id){ document.getElementById(id).textContent='0'; });
    return;
  }

  var labels = raw.map(function (d) { return d.location; });
  var counts = raw.map(function (d) { return d.count; });
  var total  = counts.reduce(function (s, v) { return s + v; }, 0);
  var maxVal = Math.max.apply(null, counts);

  /* ── Stats ── */
  document.getElementById('statCountries').textContent  = raw.length;
  document.getElementById('statTopCountry').textContent = raw[0].location;
  document.getElementById('statTopCount').textContent   = raw[0].count;
  document.getElementById('statTopPct').textContent     = total > 0 ? ((raw[0].count / total) * 100).toFixed(1) + '%' : '0%';

  /* ── Palette ── */
  var PALETTE = [
    '#2563EB','#3B82F6','#60A5FA','#93C5FD','#1D4ED8',
    '#1E40AF','#BFDBFE','#7DD3FC','#0EA5E9','#38BDF8',
    '#0284C7','#0369A1','#BAE6FD','#075985','#0C4A6E',
  ];
  var bgColors = labels.map(function (_, i) { return PALETTE[i % PALETTE.length]; });

  /* ── Doughnut chart ── */
  var ctx = document.getElementById('geoChart').getContext('2d');
  var chartInstance = new Chart(ctx, {
    type: 'doughnut',
    data: {
      labels: labels,
      datasets: [{
        data:            counts,
        backgroundColor: bgColors,
        borderColor:     '#F1F5F9',
        borderWidth:     2,
        hoverOffset:     8,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      cutout: '58%',
      animation: { duration: 700, easing: 'easeOutQuart' },
      plugins: {
        legend: {
          position: 'right',
          labels: {
            boxWidth: 12, padding: 14, font: { size: 11.5 }, color: '#334155',
            generateLabels: function (chart) {
              return Chart.overrides.doughnut.plugins.legend.labels
                .generateLabels(chart)
                .map(function (item) {
                  if (item.text && item.text.length > 20) item.text = item.text.slice(0, 18) + '…';
                  return item;
                });
            }
          }
        },
        tooltip: {
          backgroundColor: '#0F172A', titleColor: '#60A5FA', bodyColor: '#E2E8F0',
          padding: 12, cornerRadius: 8, borderColor: 'rgba(59,130,246,0.3)', borderWidth: 1,
          callbacks: {
            label: function (item) {
              var pct = total > 0 ? ((item.raw / total) * 100).toFixed(1) : 0;
              return '  ' + item.label + ': ' + item.raw + ' alumni (' + pct + '%)';
            }
          }
        }
      }
    }
  });

  /* ── Table ── */
  var tbody = document.getElementById('geoTableBody');
  raw.forEach(function (d, i) {
    var pct    = total > 0 ? ((d.count / total) * 100).toFixed(1) : 0;
    var barPct = maxVal > 0 ? (d.count / maxVal * 100).toFixed(1) : 0;
    var rankClass = i === 0 ? 'geo-rank-1' : i === 1 ? 'geo-rank-2' : i === 2 ? 'geo-rank-3' : 'geo-rank-n';
    var tr = document.createElement('tr');
    tr.innerHTML =
      '<td><span class="geo-rank ' + rankClass + '">' + (i + 1) + '</span></td>' +
      '<td style="font-weight:600;color:var(--up-text)">' + d.location + '</td>' +
      '<td style="font-weight:700;color:var(--up-blue)">' + d.count + '</td>' +
      '<td>' +
        '<div style="display:flex;align-items:center;gap:8px;">' +
          '<div class="geo-bar-wrap"><div class="geo-bar" style="width:' + barPct + '%"></div></div>' +
          '<span style="font-size:11.5px;color:var(--up-muted);min-width:38px">' + pct + '%</span>' +
        '</div>' +
      '</td>';
    tbody.appendChild(tr);
  });

  /* ── Export ── */
  document.getElementById('btnDownload').addEventListener('click', function () {
    var a = document.createElement('a');
    a.href     = chartInstance.toBase64Image('image/png', 1);
    a.download = 'geographic-distribution.png';
    a.click();
  });
})();
</script>
