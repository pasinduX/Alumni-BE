<%# views/university/partials/filter-bar.ejs %>
<%
  var _active = (selectedProgramme ? 1 : 0) + (selectedYear ? 1 : 0);
%>
<style>
  .up-filter-bar {
    background: var(--up-white);
    border: 1px solid var(--up-border);
    border-radius: var(--up-radius);
    padding: 0.65rem 1.25rem;
    box-shadow: var(--up-shadow);
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .up-filter-bar-left {
    display: flex; align-items: center; gap: 7px; flex-shrink: 0;
  }
  .up-filter-bar-left svg { width: 14px; height: 14px; stroke: var(--up-muted); flex-shrink: 0; }
  .up-filter-label { font-size: 11.5px; font-weight: 600; color: var(--up-muted); white-space: nowrap; }
  .up-filter-badge {
    font-size: 9.5px; font-weight: 800; padding: 2px 6px; border-radius: 100px;
    background: var(--up-blue); color: #fff; letter-spacing: 0.3px;
  }
  .up-filter-divider { width: 1px; height: 20px; background: var(--up-border); flex-shrink: 0; }
  .up-filter-controls { display: flex; align-items: center; gap: 0.65rem; flex-wrap: wrap; flex: 1; }
  .up-filter-select {
    padding: 0.38rem 0.75rem;
    border: 1px solid var(--up-border); border-radius: 7px;
    font-size: 12.5px; color: var(--up-text); background: var(--up-white);
    outline: none; cursor: pointer; transition: border-color 0.15s;
    min-width: 175px;
  }
  .up-filter-select:focus { border-color: var(--up-blue); }
  .up-filter-select.active { border-color: var(--up-blue); color: var(--up-blue); font-weight: 600; }
  .up-filter-clear {
    font-size: 11.5px; color: var(--up-muted); text-decoration: none;
    font-weight: 500; white-space: nowrap; transition: color 0.15s; margin-left: 4px;
  }
  .up-filter-clear:hover { color: var(--up-danger); }
</style>

<form class="up-filter-bar" method="GET" action="<%= filterAction %>">
  <div class="up-filter-bar-left">
    <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
      <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
    </svg>
    <span class="up-filter-label">Filters</span>
    <% if (_active > 0) { %>
      <span class="up-filter-badge"><%= _active %> active</span>
    <% } %>
  </div>

  <div class="up-filter-divider"></div>

  <div class="up-filter-controls">
    <select name="programme" class="up-filter-select <%= selectedProgramme ? 'active' : '' %>" onchange="this.form.submit()">
      <option value="">All Programmes</option>
      <% (programmes || []).forEach(function(p) { %>
        <option value="<%= p %>" <%= selectedProgramme === p ? 'selected' : '' %>><%= p %></option>
      <% }) %>
    </select>

    <select name="graduation_year" class="up-filter-select <%= selectedYear ? 'active' : '' %>" onchange="this.form.submit()">
      <option value="">All Graduation Years</option>
      <% (graduationYears || []).forEach(function(y) { %>
        <option value="<%= y %>" <%= String(selectedYear) === String(y) ? 'selected' : '' %>>Class of <%= y %></option>
      <% }) %>
    </select>

    <% if (_active > 0) { %>
      <a href="<%= filterAction %>" class="up-filter-clear">
        ✕ Clear filters
      </a>
    <% } %>
  </div>
</form>
