<%- /* degrees.ejs */ %>
<%
  function fmtDate(value) {
    if (!value) return '—';
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return value;
    return d.toISOString().split('T')[0];
  }
%>

<div class="page-header">
  <div class="page-header-text">
    <h1>Degrees</h1>
    <p>Your academic qualifications</p>
  </div>
</div>

<div class="card">
  <p class="card-title">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
    Academic qualifications
  </p>
  <% if ((profile.degrees || []).length === 0) { %>
    <div class="empty-state">
      <div class="empty-state-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
      </div>
      <p>No degrees added yet — add one below.</p>
    </div>
  <% } else { %>
  <table class="data-table">
    <thead>
      <tr><th>Title</th><th>Institution</th><th>Completed</th><th>URL</th><th></th></tr>
    </thead>
    <tbody>
      <% (profile.degrees || []).forEach(function(d) { %>
        <tr data-profile-degree='<%- JSON.stringify(d) %>'>
          <td><%= d.title %></td>
          <td style="color:var(--ink-mid);font-weight:400"><%= d.institution %></td>
          <td><%= fmtDate(d.completed_at) %></td>
          <td><% if (d.url) { %><a class="table-link" href="<%= d.url %>" target="_blank" rel="noopener">View ↗</a><% } else { %>—<% } %></td>
          <td style="display:flex;gap:8px;justify-content:flex-end;">
            <button type="button" class="btn btn-outline btn-sm edit-degree-btn" data-id="<%= d.id %>">Edit</button>
            <form method="post" action="/web/profile/degrees/<%= d.id %>/delete" style="display:inline" onsubmit="return confirm('Remove this degree?')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="btn btn-danger btn-sm">Remove</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>

<div class="card">
  <p class="card-title">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    Add degree
  </p>
  <form method="post" action="/web/profile/degrees">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">Degree title <span class="required">*</span></label>
        <input class="form-control" name="title" placeholder="BSc Computer Science" required />
      </div>
      <div class="form-group">
        <label class="form-label">Institution <span class="required">*</span></label>
        <input class="form-control" name="institution" placeholder="University of Eastminster" required />
      </div>
      <div class="form-group">
        <label class="form-label">Certificate URL</label>
        <input class="form-control" type="url" name="url" placeholder="https://…" />
      </div>
      <div class="form-group">
        <label class="form-label">Completed date</label>
        <input class="form-control" type="date" name="completed_at" />
      </div>
    </div>
    <button type="submit" class="btn btn-gold">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Add degree
    </button>
  </form>
</div>

<script>
  (function() {
    const csrfToken = '<%= csrfToken %>';
    let activeEditRow;

    function fmtDate(value) {
      if (!value) return "";
      const d = new Date(value);
      if (Number.isNaN(d.getTime())) return value;
      return d.toISOString().split('T')[0];
    }

    function closeEditRow() {
      if (!activeEditRow) return;
      activeEditRow.originalRow.style.display = '';
      activeEditRow.formRow.remove();
      activeEditRow = null;
    }

    function buildEditRow(entry, row) {
      const formRow = document.createElement('tr');
      formRow.className = 'edit-row';
      formRow.innerHTML = `
        <td colspan="5">
          <form class="degree-edit-form" data-id="${entry.id}">
            <div style="display:grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 10px; align-items: center;">
              <input name="title" placeholder="Degree title" required value="${entry.title || ''}" />
              <input name="institution" placeholder="Institution" required value="${entry.institution || ''}" />
              <input type="date" name="completed_at" value="${fmtDate(entry.completed_at)}" />
              <input type="url" name="url" placeholder="URL" value="${entry.url || ''}" />
            </div>
            <div style="margin-top:10px; display:flex; gap: 8px; justify-content:flex-end;">
              <button type="button" class="btn btn-outline btn-sm cancel-edit">Cancel</button>
              <button type="submit" class="btn btn-gold btn-sm">Save</button>
            </div>
          </form>
        </td>
      `;

      return formRow;
    }

    document.querySelectorAll('.edit-degree-btn').forEach(btn => {
      btn.addEventListener('click', (event) => {
        closeEditRow();

        const row = event.target.closest('tr');
        if (!row) return;

        const entry = JSON.parse(row.getAttribute('data-profile-degree') || '{}');
        const formRow = buildEditRow(entry, row);

        row.style.display = 'none';
        row.parentNode.insertBefore(formRow, row.nextSibling);

        activeEditRow = { originalRow: row, formRow };

        formRow.querySelector('.cancel-edit').addEventListener('click', closeEditRow);

        formRow.querySelector('.degree-edit-form').addEventListener('submit', async (e) => {
          e.preventDefault();
          const form = e.currentTarget;
          const id = form.getAttribute('data-id');
          const data = {
            title: form.title.value.trim(),
            institution: form.institution.value.trim(),
            completed_at: form.completed_at.value || null,
            url: form.url.value.trim() || null,
          };

          try {
            const res = await fetch(`/profile/degrees/${id}`, {
              method: 'PUT',
              credentials: 'same-origin',
              headers: {
                'Content-Type': 'application/json',
                'x-csrf-token': csrfToken,
              },
              body: JSON.stringify(data),
            });

            if (!res.ok) {
              const err = await res.json().catch(() => ({}));
              alert(err.error || 'Unable to update degree, try again.');
              return;
            }

            window.location.reload();
          } catch (er) {
            console.error(er);
            alert('Network error while updating.');
          }
        });
      });
    });

  })();
</script>
