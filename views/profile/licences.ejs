<h1>Licences</h1>
<table class="table">
  <thead><tr><th>Title</th><th>Awarding Body</th><th>URL</th><th>Completed At</th><th>Action</th></tr></thead>
  <tbody>
    <% (profile.licences||[]).forEach((d)=>{ %>
      <tr>
        <td><%= d.title %></td><td><%= d.awarding_body %></td><td><a href="<%= d.url %>"><%= d.url %></a></td><td><%= d.completed_at || '' %></td>
        <td>
          <form method="post" action="/web/profile/licences/<%= d.id %>/delete" style="display:inline">
            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
<hr />
<h3>Add Licence</h3>
<form method="post" action="/web/profile/licences">
  <div class="mb-3"><input required name="title" placeholder="Title" class="form-control" /></div>
  <div class="mb-3"><input name="awarding_body" placeholder="Awarding Body" class="form-control" /></div>
  <div class="mb-3"><input type="url" name="url" placeholder="URL" class="form-control" /></div>
  <div class="mb-3"><input type="date" name="completed_at" class="form-control" /></div>
  <button class="btn btn-primary">Add</button>
</form>