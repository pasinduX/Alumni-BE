<%- /* courses.ejs */ %>
<%
  function fmtDate(value) {
    if (!value) return '—';
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return value;
    return d.toISOString().split('T')[0];
  }
%>

<div class="page-header">
  <div class="page-header-text">
    <h1>Professional Courses</h1>
    <p>Courses and continuing education</p>
  </div>
</div>

<div class="card">
  <p class="card-title">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
    Courses
  </p>
  <% if ((profile.professional_courses || []).length === 0) { %>
    <div class="empty-state">
      <div class="empty-state-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      </div>
      <p>No courses added yet — add one below.</p>
    </div>
  <% } else { %>
  <table class="data-table">
    <thead>
      <tr><th>Title</th><th>Provider</th><th>Completed</th><th>URL</th><th></th></tr>
    </thead>
    <tbody>
      <% (profile.professional_courses || []).forEach(function(d) { %>
        <tr data-profile-course='<%- JSON.stringify(d) %>'>
          <td><%= d.title %></td>
          <td style="color:var(--ink-mid);font-weight:400"><%= d.provider || '—' %></td>
          <td><%= fmtDate(d.completed_at) %></td>
          <td><% if (d.url) { %><a class="table-link" href="<%= d.url %>" target="_blank" rel="noopener">View ↗</a><% } else { %>—<% } %></td>
          <td style="display:flex;gap:8px;justify-content:flex-end;">
            <button type="button" class="btn btn-outline btn-sm edit-course-btn" data-id="<%= d.id %>">Edit</button>
            <form method="post" action="/web/profile/courses/<%= d.id %>/delete" style="display:inline" onsubmit="return confirm('Remove this course?')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="btn btn-danger btn-sm">Remove</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>

<div class="card">
  <p class="card-title">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    Add course
  </p>
  <form method="post" action="/web/profile/courses">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">Course title <span class="required">*</span></label>
        <input class="form-control" name="title" placeholder="Machine Learning Fundamentals" required />
      </div>
      <div class="form-group">
        <label class="form-label">Provider</label>
        <input class="form-control" name="provider" placeholder="Coursera" />
      </div>
      <div class="form-group">
        <label class="form-label">Course URL</label>
        <input class="form-control" type="url" name="url" placeholder="https://…" />
      </div>
      <div class="form-group">
        <label class="form-label">Completed date</label>
        <input class="form-control" type="date" name="completed_at" />
      </div>
    </div>
    <button type="submit" class="btn btn-gold">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Add course
    </button>
  </form>
</div>

<script>
(function() {
  const csrfToken = '<%= csrfToken %>';
  let activeEditRow;

  function fmtDate(value) {
    if (!value) return '';
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return value;
    return d.toISOString().split('T')[0];
  }

  function closeEditRow() {
    if (!activeEditRow) return;
    activeEditRow.originalRow.style.display = '';
    activeEditRow.formRow.remove();
    activeEditRow = null;
  }

  function buildEditRow(entry) {
    const formRow = document.createElement('tr');
    formRow.className = 'edit-row';
    formRow.innerHTML = `
      <td colspan="5">
        <form class="course-edit-form" data-id="${entry.id}">
          <div style="display:grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 10px; align-items: center;">
            <input name="title" placeholder="Course title" required value="${entry.title || ''}" />
            <input name="provider" placeholder="Provider" value="${entry.provider || ''}" />
            <input type="date" name="completed_at" value="${fmtDate(entry.completed_at)}" />
            <input type="url" name="url" placeholder="URL" value="${entry.url || ''}" />
          </div>
          <div style="margin-top:10px; display:flex; gap:8px; justify-content:flex-end;">
            <button type="button" class="btn btn-outline btn-sm cancel-edit">Cancel</button>
            <button type="submit" class="btn btn-gold btn-sm">Save</button>
          </div>
        </form>
      </td>
    `;
    return formRow;
  }

  document.querySelectorAll('.edit-course-btn').forEach(btn => {
    btn.addEventListener('click', (event) => {
      closeEditRow();
      const row = event.target.closest('tr');
      if (!row) return;
      const entry = JSON.parse(row.getAttribute('data-profile-course') || '{}');
      const formRow = buildEditRow(entry);
      row.style.display = 'none';
      row.parentNode.insertBefore(formRow, row.nextSibling);
      activeEditRow = { originalRow: row, formRow };

      formRow.querySelector('.cancel-edit').addEventListener('click', closeEditRow);

      formRow.querySelector('.course-edit-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.currentTarget;
        const id = form.getAttribute('data-id');
        const data = {
          title: form.title.value.trim(),
          provider: form.provider.value.trim() || null,
          completed_at: form.completed_at.value || null,
          url: form.url.value.trim() || null,
        };

        try {
          const res = await fetch(`/profile/professional_courses/${id}`, {
            method: 'PUT',
            credentials: 'same-origin',
            headers: {
              'Content-Type': 'application/json',
              'x-csrf-token': csrfToken,
            },
            body: JSON.stringify(data),
          });

          if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            alert(err.error || 'Unable to update course, try again.');
            return;
          }

          window.location.reload();
        } catch (err) {
          console.error(err);
          alert('Network error while updating');
        }
      });
    });
  });
})();
</script>
